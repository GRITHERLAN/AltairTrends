// Configuración de Cloudflare Workers: el sitio es estático (lo que genera
// "npm run build" en dist/). No hay código de servidor.
// Las cabeceras de seguridad están en public/_headers.
{
  // Debe coincidir EXACTAMENTE con el nombre del Worker en el panel de Cloudflare.
  "name": "altairtrends",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Las páginas públicas tienen URL real (/sobre-nosotros, /producto/...).
    // Para cualquier ruta que no sea un archivo se sirve index.html y React
    // decide qué página mostrar (ver src/hooks/useRuta.jsx).
    "not_found_handling": "single-page-application"
  }
}
